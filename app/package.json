{
  "name": "recomendacao-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"testes/unidade/**/*.test.js\" testes/isolamento.test.js testes/congelamento.test.js",
    "test:integracao": "node --test --test-concurrency=1 \"testes/integracao/**/*.test.js\" \"testes/referencia/**/*.test.js\"",
    "test:web": "npm --prefix web test",
    "e2e": "playwright test -c testes/e2e/playwright.config.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.11",
    "adm-zip": "^0.6.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "es-module-lexer": "^1.7.0"
  }
}
